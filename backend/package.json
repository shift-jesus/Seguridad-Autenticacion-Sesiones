{
  "name": "auth-sesiones-backend",
  "version": "2.0.0",
  "description": "Mini app educativa: Autenticacion, sesiones seguras, 2FA, admin y mas",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node database/seed.js",
    "db:reset": "node -e \"const fs=require('node:fs');const p=require('./config/env').dbPath;if(fs.existsSync(p)){fs.unlinkSync(p);console.log('DB eliminada:',p);}\"",
    "test": "node --test --test-reporter=spec \"test/**/*.test.js\"",
    "lint": "eslint . --ignore-pattern node_modules",
    "format": "prettier --write \"**/*.js\" \"**/*.html\" \"**/*.css\""
  },
  "keywords": [
    "auth",
    "sessions",
    "http-only-cookies",
    "seguridad",
    "educativo",
    "2fa",
    "csrf"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "express-validator": "^7.3.2",
    "helmet": "^7.1.0",
    "morgan": "^1.12.1",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0"
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}