# Puerto del servidor
PORT=3000

# Entorno: development | production
NODE_ENV=development

# Secreto usado para firmar la cookie de sesion.
# IMPORTANTE: en produccion usar un valor largo, aleatorio y unico.
# Se puede generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=cambia_este_valor_por_uno_generado_aleatoriamente

# Nombre de la cookie de sesion (evita usar el nombre por defecto "connect.sid")
SESSION_COOKIE_NAME=sid

# Duracion de la sesion en milisegundos (30 minutos por defecto)
SESSION_MAX_AGE_MS=1800000

# Origen permitido para CORS (frontend)
CLIENT_ORIGIN=http://localhost:5500

# Numero de "salt rounds" para bcrypt (10-12 es un buen balance costo/seguridad)
BCRYPT_SALT_ROUNDS=12
