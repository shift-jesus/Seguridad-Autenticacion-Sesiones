# Puerto del servidor
PORT=3000

# Entorno: development | production
NODE_ENV=development

# Secreto usado para firmar la cookie de sesion.
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=cambia_este_valor_por_uno_generado_aleatoriamente

# Nombre de la cookie de sesion (evita el nombre por defecto "connect.sid")
SESSION_COOKIE_NAME=sid

# Duracion de la sesion en milisegundos (por defecto 30 minutos)
SESSION_MAX_AGE_MS=1800000

# Expira absoluta de la sesion aunque se "renueve" con uso (/me tambien la corta)
SESSION_ABSOLUTE_MAX_AGE_MS=43200000

# Origen permitido para CORS (frontend con Live Server). Puede ser lista: "http://a,http://b"
CLIENT_ORIGIN=http://localhost:5500

# Salt rounds de bcrypt (10-12 balance costo/seguridad)
BCRYPT_SALT_ROUNDS=12

# Ruta de la base SQLite (datos + sesiones + actividad)
DB_PATH=database/app.db

# Politica de contrasenas
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128

# Anti fuerza bruta (cuenta + IP)
LOCKOUT_MAX_INTENTOS=5
LOCKOUT_VENTANA_MS=900000
LOCKOUT_PENALIZACION_MS=900000

# Tokens (verificar email / reset) — duracion en ms
TOKEN_TTL_MS=1800000

# 2FA
MFA_ISSUER=DemoAuth
MFA_BACKUP_CODES=8

# Cookie CSRF
CSRF_COOKIE_NAME=csrfToken

# Detras de un proxy/reverse proxy (nginx, etc.) -> true para respetar X-Forwarded-For
TRUST_PROXY=false